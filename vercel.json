{
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 20,
      "includeFiles": "server-dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/worker",
      "destination": "/api/index?_endpoint=worker"
    },
    {
      "source": "/api/auth",
      "destination": "/api/index?_endpoint=auth"
    },
    {
      "source": "/api/online",
      "destination": "/api/index?_endpoint=online"
    },
    {
      "source": "/api/bot",
      "destination": "/api/index?_endpoint=bot"
    },
    {
      "source": "/api/game",
      "destination": "/api/index?_endpoint=game"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/nusantara-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ]
}
