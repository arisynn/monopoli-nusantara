{
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 20,
      "includeFiles": "server-dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/online",
      "destination": "/api/index?_endpoint=online"
    },
    {
      "source": "/api/bot",
      "destination": "/api/index?_endpoint=bot"
    },
    {
      "source": "/api/game",
      "destination": "/api/index?_endpoint=game"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
