{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/api/**/*.ts",
    "lib/groq.ts",
    "lib/storage.ts",
    "lib/bot/contracts.ts",
    "lib/presentation-types.ts",
    "lib/server/runtime.ts",
    "tests/types/**/*.ts",
    "api/**/*.ts",
    "adapters/vercel/**/*.ts"
  ],
  "exclude": [
    "lib/server/runtime-sites.ts",
    "supabase/functions",
    "node_modules"
  ]
}
