# Semua variabel ini khusus server. Jangan memakai awalan NEXT_PUBLIC_.
# Hotseat + bot lokal berjalan tanpa variabel apa pun.

# Room online di Vercel: isi dua nilai dari Upstash Redis / Vercel Storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alias dari integrasi lama juga didukung: KV_REST_API_URL / KV_REST_API_TOKEN.

# Opsional: AI Groq. Memerlukan room Redis aktif pada Vercel.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Opsional. Biarkan kosong agar production/preview/development terpisah.
ROOM_NAMESPACE=
# Masa simpan room sejak perubahan terakhir, default 7 hari; 3600–2592000 detik.
ROOM_TTL_SECONDS=604800
