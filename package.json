{
  "name": "monopoli-nusantara",
  "version": "4.5.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/game.test.mjs tests/classic.test.mjs tests/storage.test.mjs tests/portrait.test.mjs tests/save-format.test.mjs tests/room-client.test.mjs tests/board-2d.test.mjs tests/ui-refinement.test.mjs tests/pawn-flow.test.mjs tests/asset-trade-v26.test.mjs tests/gameplay-flow-v28.test.mjs tests/compact-ui-v29.test.mjs tests/gameplay-v210.test.mjs tests/board-visual-v211.test.mjs tests/online.test.mjs tests/online-client.test.mjs tests/online-api.test.mjs tests/bot-strategy.test.mjs tests/groq-hybrid.test.mjs tests/bot-api.test.mjs tests/online-bots.test.mjs tests/experience-v45.test.mjs tests/experience-render-v45.test.mjs",
    "dev:vercel": "next dev",
    "build:vercel": "next build --webpack",
    "start:vercel": "next start",
    "test:vercel": "node tests/vercel-build.test.mjs && node tests/redis.test.mjs",
    "test:online": "node tests/online.test.mjs && node tests/online-client.test.mjs && node tests/online-api.test.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:supabase": "node tests/supabase-live.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:bots": "node --test --test-isolation=none tests/bot-strategy.test.mjs tests/groq-hybrid.test.mjs tests/bot-api.test.mjs tests/online-bots.test.mjs",
    "benchmark:bots": "node scripts/benchmark-bots.mjs",
    "test:supabase:bots": "node tests/supabase-bots-live.test.mjs",
    "test:experience": "node --test --test-isolation=none tests/experience-v45.test.mjs tests/experience-render-v45.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
