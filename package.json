{
  "name": "monopoli-nusantara",
  "version": "4.8.3",
  "private": true,
  "type": "module",
  "description": "Nusantara \u2014 Classic 2D UI, shared rules, local NUSA MIND and persistent Supabase multiplayer",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --experimental-strip-types --import ./adapters/node/aliases.mjs scripts/test-headless.mjs",
    "start": "node --env-file-if-exists=.env --experimental-strip-types --import ./adapters/node/aliases.mjs adapters/node/server.mjs",
    "demo": "node examples/local-game.mjs",
    "selfplay": "node examples/self-play.mjs",
    "test:online": "node --experimental-strip-types --test --test-isolation=none tests/online.test.mjs tests/online-client.test.mjs tests/online-api.test.mjs tests/online-bots.test.mjs",
    "benchmark:mind": "node scripts/benchmark-mind.mjs",
    "benchmark:bots": "node scripts/benchmark-bots.mjs",
    "typecheck": "tsc --noEmit",
    "test:supabase": "node tests/supabase-live.test.mjs",
    "test:supabase:bots": "node tests/supabase-bots-live.test.mjs",
    "build": "node scripts/build-web.mjs",
    "build:vercel": "node scripts/build-web.mjs",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --import ./adapters/node/aliases.mjs adapters/node/server.mjs",
    "test:frontend": "node --experimental-strip-types --import ./adapters/node/aliases.mjs --test --test-isolation=none tests/frontend.test.mjs",
    "pretest": "npm run build",
    "pretest:frontend": "npm run build",
    "check:source": "node --experimental-vm-modules scripts/verify-web.mjs",
    "smoke:ui": "node --experimental-strip-types scripts/smoke-session.mjs",
    "test:browser": "node --experimental-strip-types scripts/test-browser.mjs",
    "test:compact": "node --experimental-strip-types scripts/test-compact-browser.mjs",
    "diagnose:online": "node scripts/diagnose-online.mjs",
    "test:plan": "node --experimental-strip-types scripts/test-plan-browser.mjs",
    "test:assets": "node --experimental-strip-types scripts/test-assets-browser.mjs",
    "format": "prettier --write frontend lib/groq.ts lib/storage.ts lib/version.mjs adapters/node scripts/build-web.mjs scripts/build-fingerprint.mjs",
    "format:check": "prettier --check frontend lib/groq.ts lib/storage.ts lib/version.mjs adapters/node scripts/build-web.mjs scripts/build-fingerprint.mjs",
    "test:stability": "node --experimental-strip-types scripts/test-stability-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {}
}
